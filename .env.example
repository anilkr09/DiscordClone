# Copy to .env (gitignored) and replace every value. Used by the backend and docker compose.
# Use plain KEY=value lines: no quotes and no "export".

# JWT signing key: at least 64 characters for HS512. Generate with: openssl rand -hex 64
JWT_SECRET=

# PostgreSQL password for dev_user. An existing pgdata volume keeps the password it was created with.
DB_PASSWORD=change-me

REDIS_PASSWORD=change-me

PGADMIN_PASSWORD=change-me

# Web client origin used in invite links (default http://localhost:5173)
# FRONTEND_URL=

# Comma-separated web origins allowed to call the API
# ALLOWED_ORIGINS=
# Set to None if the web client is on a different site than the API
# COOKIE_SAME_SITE=Strict

# Development seed user; also needs app.seed.enabled=true
# SEED_PASSWORD=

# Only needed for ./gradlew sonar
# SONAR_TOKEN=

# Plain-text logs for local work instead of JSON
LOG_FORMAT=
# Send traces to an OpenTelemetry collector
# TRACING_EXPORT=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
